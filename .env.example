# NewDogRelic local-dev environment variables
# Copy this file to .env and adjust values as needed.
# DO NOT commit .env to version control.
#
# Production values are managed via External Secrets Operator + HashiCorp Vault.
# See CLAUDE.md Layer 8 (HIPAA / Security Stack) for production secret management.

# ---------------------------------------------------------------------------
# Kafka
# ---------------------------------------------------------------------------
# Bootstrap server for Kafka clients connecting from the host
KAFKA_BOOTSTRAP=localhost:9092

# ---------------------------------------------------------------------------
# Postgres (IOx catalog + application database)
# ---------------------------------------------------------------------------
POSTGRES_URL=postgres://ndr:ndr@localhost:5432/ndr_catalog

# ---------------------------------------------------------------------------
# MinIO / S3-compatible object store
# IMPORTANT: minioadmin credentials are LOCAL-DEV ONLY.
# Never use these credentials in staging or production.
# ---------------------------------------------------------------------------
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin

# Cold-tier Parquet storage bucket
# Partitioning scheme: signals/{tenant_id}/{signal_type}/{year}/{month}/{day}/{hour}/
S3_BUCKET_COLD=ndr-cold

# HIPAA audit log bucket (Object Lock enabled in production; S3-versioned in local dev)
S3_BUCKET_AUDIT=ndr-audit
